# SecureGuard AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# You only need ONE of these keys (not both), depending on which provider you use.
# The code will automatically detect which key is valid and use that provider.
#
# For Anthropic (Claude):
#   Get your key at: https://console.anthropic.com/
#   Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# For OpenAI (GPT-4):
#   Get your key at: https://platform.openai.com/api-keys
#   Format: sk-...
OPENAI_API_KEY=

# IMPORTANT: Remove the placeholder text and paste your actual API key
# Example (Anthropic): ANTHROPIC_API_KEY=sk-ant-api03-abc123xyz...
# Example (OpenAI):    OPENAI_API_KEY=sk-proj-abc123xyz...

# ============================================================================
# LLM Configuration
# ============================================================================
# Default LLM Provider: 'openai' or 'anthropic'
LLM_PROVIDER=anthropic

# Model Configuration (optional - defaults based on provider)
# For Anthropic: claude-sonnet-4-20250514 (default), claude-opus-4-20250514
# For OpenAI: gpt-4o (default), gpt-4o-mini, gpt-4-turbo
LLM_MODEL=claude-sonnet-4-20250514

# Temperature (0.0 = deterministic, 1.0 = creative)
# Keep at 0.0 for security fixes to ensure consistent, reliable output
LLM_TEMPERATURE=0

# Max tokens for LLM responses (controls cost)
# Lower = cheaper but may truncate responses
# Recommended: 1024-2048 for cost savings, 4096 for full responses
LLM_MAX_TOKENS=2048

# Agent Configuration
MAX_RETRIES=3
MAX_ITERATIONS=10
VERBOSE=true

# Review Mode: 'interactive' or 'automatic'
REVIEW_MODE=interactive

# False Positive Filter Threshold (0.0 - 1.0)
FP_CONFIDENCE_THRESHOLD=0.75

# Output Directory
OUTPUT_DIR=output
